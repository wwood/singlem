        "truth": "/home/woodcrob/m/msingle/mess/231_singlem2_messing_more/toy_sim/marine0.condensed",
    },
    "known100": {
        "forward": "/home/woodcrob/m/msingle/mess/231_singlem2_messing_more/singlem-benchmarking/5_100_species_known/generated_reads/known0.1.fq.gz",
        "reverse": "/home/woodcrob/m/msingle/mess/231_singlem2_messing_more/singlem-benchmarking/5_100_species_known/generated_reads/known0.2.fq.gz",
