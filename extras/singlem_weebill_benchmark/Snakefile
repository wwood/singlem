        "reverse": "/home/woodcrob/m/msingle/mess/231_singlem2_messing_more/singlem-benchmarking/6_100_species_known_shadow_strains/generated_reads/known0.2.fq.gz",
        "truth": "/home/woodcrob/m/msingle/mess/231_singlem2_messing_more/singlem-benchmarking/6_100_species_known_shadow_strains/truths/known0.condensed",
    },
