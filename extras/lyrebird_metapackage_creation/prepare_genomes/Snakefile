    output:
        done = touch("vcontact3_taxonomy_processed.done"),
        taxonomy_tsv = "final_reconstructed_metadata.tsv"
    resources:
        mem_mb = 12 * 1024,
    log:
        "logs/process_vcontact3_taxonomy.log"
    script:
        "scripts/process_vcontact3_taxonomy.py"
