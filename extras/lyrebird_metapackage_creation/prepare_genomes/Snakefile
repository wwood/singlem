"""
Steps:
1. Create base environment:
    conda env create -f ../envs/create_metapackage.yml -n lyrebird-metapackage
2. Install vcontact3 and download the latest vcontact3 database
    conda create -n vcontact3 python=3.10
    conda activate vcontact3
    git clone https://bitbucket.org/MAVERICLab/vcontact3.git
    cd vcontact3
    python -m pip install .
    vcontact3 prepare_databases --get-version 232 --set-location ./db (or use --get-version latest)
3. Update the variables vcontact_env and vcontact_db_path below with your conda environment name and database path
4. Download metaVR metadata and genomes, and update the variables (this is a >77GB download, ensure you have enough space)
    wget https://www.meta-virome.org/DownloadUvigMetadata
    wget https://www.meta-virome.org/DownloadUvigFasta
5. Run the Snakefile:
    conda activate lyrebird-metapackage
    snakemake --use-conda --conda-frontend mamba --cores 64 --profile aqua --directory <output_directory> --conda-prefix <path_to_conda_envs>  
"""
import os
from Bio import SeqIO

vcontact_env = "vcontact3-v3.2.0" # Specify your pre-installed vcontact3 conda environment
vcontact_db_path = "/mnt/weka/scratch/microbiome/n10927662/vcontact3/db/232.json" # Specify your downloaded vcontact3 database path
metavr_metadata_fp = "/mnt/hpccs01/work/microbiome/msingle/rossenzhao/metaVR/uvig_metadata.tsv.gz" # Specify your downloaded metaVR metadata file path
metavr_genomes_fp = "/mnt/hpccs01/work/microbiome/msingle/rossenzhao/metaVR/IMGVR5_UViG.fna.gz" # Specify your downloaded metaVR genomes file path
galah_chunk_size = int(config.get("galah_chunk_size", 50000))

localrules: split_metavr_genomes, process_taxonomy

rule all:
    input:
        "prodigal_gv.done",
        "vcontact3_taxonomy_processed.done",

rule get_ictv_genomes:
    params:
        url = 'https://ictv.global/vmr/current'
    output:
        done = touch("ictv/done"),
        outdir = directory("ictv")
    log:
        "logs/get_ictv_genomes.log"
    resources:
        mem_mb = 20 * 1024,
        runtime = "2h",  # 2 hours
    conda:
        "envs/ictv-download.yml"
    shell:
        "python {workflow.basedir}/scripts/ictv-download.py --url {params.url} --outdir {output.outdir} &> {log}"

rule get_metavr_genomes:
    input:
        metadata_fp = metavr_metadata_fp,
        genomes_fp = metavr_genomes_fp,
    output:
        done = touch("metavr/done"),
        outdir = directory("metavr")
    log:
        "logs/get_metavr_genomes.log"
    resources:
        mem_mb = 64 * 1024,
        runtime = "12h",  # 12 hours
    conda:
        "envs/ictv-download.yml"
    shell:
        "python {workflow.basedir}/scripts/metavr-download.py "\
        "--metadata-file {input.metadata_fp} " \
        "--genome-file {input.genomes_fp} " \
        "--outdir {output.outdir} &> {log}"

rule cluster_ictv:
    input:
        ictv_done = "ictv/done",
        ictv_dir = "ictv/genomes"
    output:
        representative_genomes_list = "ictv_representative_genomes.list"
    log:
        "logs/cluster_ictv.log"
    threads: 8
    resources:
        mem_mb = 64 * 1024,
        runtime = "8h",
    conda:
        "envs/galah.yml"
    shell:
        "find {input.ictv_dir} -type f | sort > ictv_genome_filepaths.list && "
        "galah cluster --genome-fasta-list ictv_genome_filepaths.list --threads {threads} "
        "--ani 95 --min-aligned-fraction 85 --fragment-length 500 "
        "--precluster-method skani --precluster-ani 90 --small-genomes "
        "--output-representative-list {output.representative_genomes_list} "
        "&> {log}"

checkpoint split_metavr_genomes:
    input:
        metavr_done = "metavr/done",
        metavr_dir = "metavr/genomes"
    output:
        manifest = "metavr_genome_chunk_manifest.tsv",
        chunk_dir = directory("metavr_genome_chunks")
    log:
        "logs/split_metavr_genomes.log"
    resources:
        runtime = "1h",
    run:
        genome_filepaths = sorted(
            os.path.join(input.metavr_dir, filename)
            for filename in os.listdir(input.metavr_dir)
            if filename.endswith((".fna", ".fasta"))
        )
        if galah_chunk_size < 1:
            raise ValueError("galah_chunk_size must be positive")
        if not genome_filepaths:
            raise ValueError("No metaVR genome filepaths were found")

        os.makedirs(output.chunk_dir, exist_ok=True)
        chunks = []
        for chunk_number in range(0, len(genome_filepaths), galah_chunk_size):
            chunk_id = f"metavr-{chunk_number // galah_chunk_size:06d}"
            chunk_filepaths = genome_filepaths[chunk_number:chunk_number + galah_chunk_size]
            chunk_filepath = os.path.join(output.chunk_dir, f"{chunk_id}.genome-list.txt")
            with open(chunk_filepath, "w") as outfile:
                outfile.write("\n".join(chunk_filepaths))
                outfile.write("\n")
            chunks.append((chunk_id, len(chunk_filepaths)))

        with open(output.manifest, "w") as outfile:
            outfile.write("chunk\tgenome_count\n")
            for chunk_id, genome_count in chunks:
                outfile.write(f"{chunk_id}\t{genome_count}\n")


def genome_chunk_ids(wildcards):
    checkpoint_output = checkpoints.split_metavr_genomes.get(**wildcards).output
    with open(checkpoint_output.manifest) as infile:
        return [line.split("\t", 1)[0] for line in infile.read().splitlines()[1:]]


rule galah_cluster_chunk:
    input:
        genome_filepaths = lambda wildcards: os.path.join(
            checkpoints.split_metavr_genomes.get(**wildcards).output.chunk_dir,
            f"{wildcards.chunk}.genome-list.txt",
        ),
        reference_genomes = "ictv_representative_genomes.list",
    output:
        rep_list = temp("galah_chunks/{chunk}/representatives.txt"),
    log:
        "logs/galah_chunks/{chunk}.log"
    threads: 16
    resources:
        mem_mb = 128 * 1024,
        runtime = "8h",  # 8 hours
    conda:
        "envs/galah.yml"
    shell:
        "galah cluster --genome-fasta-list {input.genome_filepaths} --threads {threads} "\
        "--reference-genomes-list {input.reference_genomes} --skip-input-dereplication "\
        "--ani 95 --min-aligned-fraction 85 --fragment-length 500 --small-genomes "\
        "--precluster-method skani --precluster-ani 90 "\
        "--output-representative-list {output.rep_list} "\
        "&> {log}"

rule merge_galah_chunks:
    input:
        chunk_reps = lambda wildcards: [
            f"galah_chunks/{chunk}/representatives.txt"
            for chunk in genome_chunk_ids(wildcards)
        ],
        ictv_reps = "ictv_representative_genomes.list",
    output:
        done = touch("galah_clustering.done"),
        cluster_dir = directory("galah_clusters"),
        merge_input_list = "galah_merge_genome_filepaths.txt"
    log:
        "logs/galah_clustering.log"
    threads: 1
    resources:
        runtime = "48h",  # 48 hours
        mem_mb = 64 * 1024,
    conda:
        "envs/galah.yml"
    shell:
        # merge the ICTV and metaVR representative genome filepath lists, sort and remove duplicates, then ln -s the representative genomes into the galah_clusters directory from the merged list
        "cat {input.ictv_reps} {input.chunk_reps} | sort | uniq > {output.merge_input_list} && "
        "mkdir -p {output.cluster_dir} && "
        "while read genome_fp; do ln -s ../$genome_fp {output.cluster_dir}/$(basename $genome_fp); done < {output.merge_input_list} && "
        "touch {output.done}"

rule prodigal_gv:
    input:
        cluster_dir = "galah_clusters"
    params:
        log_dir = "logs/prodigal_gv"
    output:
        done = touch("prodigal_gv.done"),
        transcripts_dir = directory("prodigal_transcripts"),
        proteins_dir = directory("prodigal_proteins")
    threads: 64
    resources:
        mem_mb = 500 * 1024,
        runtime = "12h",  # 12 hours
    conda:
        "envs/prodigal-gv.yml"
    shell: # use GNU parallel to speed this up
        "mkdir -p {params.log_dir} ; " \
        "mkdir -p {output.transcripts_dir} ; " \
        "mkdir -p {output.proteins_dir} ; " \
        "find {input.cluster_dir} -name '*.fna' | " \
        "parallel -j {threads} --will-cite -- 'prodigal-gv -i {{}} -a {output.proteins_dir}/{{/}}_protein.faa -d {output.transcripts_dir}/{{/}}_transcript.fna -p meta &> {params.log_dir}/{{/}}.log'" \

rule prepare_for_vcontact3:
    input:
        galah_dir = "galah_clusters",
        galah_done = "galah_clustering.done",
    output:
        done = touch("vcontact3_prepared.done"),
        concat_genomes = temp("vcontact3_concat_genomes.fna"),
    shell: # there are many files, so use cat with find
        "find {input.galah_dir} -name '*.fna' -exec cat {{}} + > {output.concat_genomes}"

rule vcontact3:
    input:
        genomes_fna = "vcontact3_concat_genomes.fna",
        vcontact_prep_done = "vcontact3_prepared.done"
    params:
        vcontact3_db = vcontact_db_path
    output:
        done = touch("vcontact3.done"),
        vcontact_output_dir = directory("vcontact3_output")
    threads: 64
    resources:
        runtime = "48h",
        mem_mb = 500 * 1024,
    log:
        "logs/vcontact3.log"
    conda:
        vcontact_env
    shell:
        "vcontact3 run -n {input.genomes_fna} "\
        "-d {params.vcontact3_db} "\
        "-t {threads} "\
        "-o {output.vcontact_output_dir} "\
        "--pyrodigal-gv "\
        "&> {log}"

