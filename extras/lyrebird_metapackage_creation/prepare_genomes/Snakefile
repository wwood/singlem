rule order_genomes_fps:
    input:
        ictv_done = "ictv/done",
        ictv_dir = "ictv",
        metavr_done = "metavr/done",
        metavr_dir = "metavr"
    params:
        ictv_metadata = "ictv/genome_metadata.tsv",
        metavr_metadata = "metavr/metavr_filtered_metadata.tsv"
    output:
        done = touch("ordered_genomes.done"),
        ordered_filepaths = "ordered_genome_filepaths.txt"
    run:
        from os.path import join
        from csv import DictReader
        # order ictv first, then metavr by length descending
        ictv_fps = []
        with open(params.ictv_metadata, 'r') as infile:
            reader = DictReader(infile, delimiter='\t')
            for row in reader:
                genome_fp = join(input.ictv_dir, "genomes", f"{row['genome']}.fna")
                ictv_fps.append( (int(row['length']), genome_fp) )
        metavr_fps = []
        with open(params.metavr_metadata, 'r') as infile:
            reader = DictReader(infile, delimiter='\t')
            for row in reader:
                genome_fp = join(input.metavr_dir, "genomes", f"{row['uvig']}.fna")
                metavr_fps.append( (int(row['length']), genome_fp) )
        # sort by length descending
        ictv_fps.sort(key=lambda x: x[0], reverse=True)
        metavr_fps.sort(key=lambda x: x[0], reverse=True)
        with open(output.ordered_filepaths, 'w') as outfile:
            for _, fp in ictv_fps:
                outfile.write(f"{fp}\n")
            for _, fp in metavr_fps:
                outfile.write(f"{fp}\n")

checkpoint split_genome_filepaths:
    input:
        genome_filepaths = "ordered_genome_filepaths.txt",
        ordered_genomes_done = "ordered_genomes.done"
    output:
        manifest = "genome_chunk_manifest.tsv",
        chunk_dir = directory("genome_chunks")
    log:
        "logs/split_genome_filepaths.log"
    resources:
        runtime = 1 * 60 * 60,  # 1 hour
    run:
        from csv import DictReader

        with open(input.genome_filepaths) as infile:
            genome_filepaths = [line.strip() for line in infile if line.strip()]
        with open("ictv/genome_metadata.tsv") as infile:
            ictv_count = sum(1 for _ in DictReader(infile, delimiter="\t"))

        if not genome_filepaths:
            raise ValueError("No genome filepaths were found")
        if ictv_count > len(genome_filepaths):
            raise ValueError("ICTV metadata contains more genomes than the ordered list")
        if galah_chunk_size < 1:
            raise ValueError("galah_chunk_size must be positive")

        os.makedirs(output.chunk_dir, exist_ok=True)
        chunks = []
        for source, source_filepaths in (
            ("ictv", genome_filepaths[:ictv_count]),
            ("metavr", genome_filepaths[ictv_count:]),
        ):
            for chunk_number in range(0, len(source_filepaths), galah_chunk_size):
                chunk_id = f"{source}-{chunk_number // galah_chunk_size:06d}"
                chunk_filepath = os.path.join(output.chunk_dir, f"{chunk_id}.genome-list.txt")
                with open(chunk_filepath, "w") as outfile:
                    outfile.write("\n".join(source_filepaths[chunk_number:chunk_number + galah_chunk_size]))
                    outfile.write("\n")
                chunks.append((chunk_id, source, len(source_filepaths[chunk_number:chunk_number + galah_chunk_size])))

        with open(output.manifest, "w") as outfile:
            outfile.write("chunk\tsource\tgenome_count\n")
            for chunk_id, source, genome_count in chunks:
                outfile.write(f"{chunk_id}\t{source}\t{genome_count}\n")


def genome_chunk_ids(wildcards):
    checkpoint_output = checkpoints.split_genome_filepaths.get(**wildcards).output
    with open(checkpoint_output.manifest) as infile:
        return [line.split("\t", 1)[0] for line in infile.read().splitlines()[1:]]


rule galah_cluster_chunk:
    input:
        genome_filepaths = lambda wildcards: os.path.join(
            checkpoints.split_genome_filepaths.get(**wildcards).output.chunk_dir,
            f"{wildcards.chunk}.genome-list.txt",
        )
    output:
        cluster_rep_tsv = "galah_chunks/{chunk}/cluster_representatives.tsv",
        cluster_dir = directory("galah_chunks/{chunk}/representatives")
    log:
        "logs/galah_chunks/{chunk}.log"
    threads: 16
    resources:
        mem_mb = 128 * 1024,
        runtime = 8 * 60 * 60,  # 8 hours
    conda:
        "envs/galah.yml"
    shell:
        "galah cluster --genome-fasta-list {input.genome_filepaths} --threads {threads} "\
        "--ani 95 --min-aligned-fraction 85 --fragment-length 500 "\
        "--precluster-method finch --precluster-ani 95 --small-genomes "\
        "--output-cluster-definition {output.cluster_rep_tsv} "\
        "--output-representative-fasta-directory {output.cluster_dir} "\
        "&> {log}"

rule galah_cluster_merge:
    input:
        chunk_tsvs = lambda wildcards: [
            f"galah_chunks/{chunk}/cluster_representatives.tsv"
            for chunk in genome_chunk_ids(wildcards)
        ],
        chunk_dirs = lambda wildcards: [
            f"galah_chunks/{chunk}/representatives"
            for chunk in genome_chunk_ids(wildcards)
        ]
    output:
        done = touch("galah_clustering.done"),
        cluster_rep_tsv = "galah_cluster_representatives.tsv",
        cluster_dir = directory("galah_clusters"),
        merge_input_list = "galah_merge_genome_filepaths.txt"
    log:
        "logs/galah_clustering.log"
    threads: 64
    resources:
        runtime = "12h",  # 12 hours
        mem_mb = 256 * 1024,
    conda:
        "envs/galah.yml"
    shell:
        "find {input.chunk_dirs} \\( -type f -o -type l \\) "\
        "\\( -name '*.fna' -o -name '*.fasta' \\) | sort > {output.merge_input_list} && "\
        "test -s {output.merge_input_list} && "\
        "galah cluster --genome-fasta-list {output.merge_input_list} --threads {threads} "\
        "--ani 95 --min-aligned-fraction 85 --fragment-length 500 "\
        "--precluster-method finch --precluster-ani 95 --small-genomes "\
        "--output-cluster-definition {output.cluster_rep_tsv} "\
        "--output-representative-fasta-directory {output.cluster_dir} "\
        "&> {log}"

rule prodigal_gv:
    input:
        cluster_dir = "galah_clusters"
    params:
        log_dir = "logs/prodigal_gv"
    output:
        done = touch("prodigal_gv.done"),
        transcripts_dir = directory("prodigal_transcripts"),
        proteins_dir = directory("prodigal_proteins")
    threads: 64
    resources:
        mem_mb = 500 * 1024,
        runtime = 12 * 60 * 60,  # 12 hours
    conda:
        "envs/prodigal-gv.yml"
    shell: # use GNU parallel to speed this up
        "mkdir -p {params.log_dir} ; " \
        "mkdir -p {output.transcripts_dir} ; " \
        "mkdir -p {output.proteins_dir} ; " \
        "find {input.cluster_dir} -name '*.fasta' | " \
        "parallel -j {threads} --will-cite -- 'prodigal-gv -i {{}} -a {output.proteins_dir}/{{/}}_protein.faa -d {output.transcripts_dir}/{{/}}_transcript.fna -p meta &> {params.log_dir}/{{/}}.log'" \

rule prepare_for_vcontact3:
    input:
        galah_dir = "galah_clusters",
        galah_done = "galah_clustering.done",
    output:
        done = touch("vcontact3_prepared.done"),
        concat_genomes = "vcontact3_concat_genomes.fna",
    shell: # there are many files, so use cat with find
        "find {input.galah_dir} -name '*.fna' -exec cat {{}} + > {output.concat_genomes}"

rule vcontact3:
    input:
        genomes_fna = "vcontact3_concat_genomes.fna",
        vcontact_prep_done = "vcontact3_prepared.done"
    params:
        vcontact3_db = vcontact_db_path
    output:
        done = touch("vcontact3.done"),
        vcontact_output_dir = directory("vcontact3_output")
    threads: 64
    resources:
        mem_mb = 500 * 1024,
    log:
        "logs/vcontact3.log"
    conda:
        vcontact_env
    shell:
        "vcontact3 run -n {input.genomes_fna} "\
        "-d {params.vcontact3_db} "\
        "-t {threads} "\
        "-o {output.vcontact_output_dir} "\
        "--pyrodigal-gv "\
        "&> {log}"

